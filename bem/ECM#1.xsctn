package require csdl

set _title "Example Two Conductor Microstrip"
set ::Stackup::couplingLength "1e-007"
set ::Stackup::riseTime "250"
set ::Stackup::frequency "1e9"
set ::Stackup::defaultLengthUnits "microns"
set CSEG 10
set DSEG 10

GroundPlane ground  \
	 -thickness 3 \
	 -yOffset 0.0 \
	 -xOffset 0.0
DielectricLayer fr4  \
 -thickness 250.0 \
	 -lossTangent 0.0 \
 -permittivity 4.5 \
	 -permeability 1.0 \
	 -yOffset 0.0 \
	 -xOffset 0.0
RectangleConductors c1  \
 -width 387.28 \
 -pitch 612.28 \
	 -conductivity 5.0e7S/m \
 -height 35.0 \
	 -number 2 \
	 -yOffset 0 \
	 -xOffset 0
